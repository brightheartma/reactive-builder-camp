# 公开配置。复制为 .env 后只填地址。不要写 PRIVATE_KEY、助记词或 keystore 密码。
# 签名用本机 keystore：命令加 --account d3-test。密码只在你自己的终端输入。

SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ORIGIN_CHAIN_ID=11155111
DEST_CHAIN_ID=11155111
# Ethereum Sepolia 的 Callback Proxy。不要换成 Base Sepolia 的地址。
# 来源：https://dev.reactive.network/origins-and-destinations （2026-11-24）
CALLBACK_PROXY=0xAa14d9Cd0f788Ca23d11805986C1d8bd035D23b4

LASNA_RPC_URL=https://lasna-rpc.rnk.dev/

# 官方脚本默认最多处理 5 次。这次练习设为 1：一笔达标 Ping 之后就退订。
THRESHOLD=100
LIMIT=1
PING_VALUE=500
# 模板预算，不是已核实的足够余额。部署前要重新 cast balance。
REACTIVE_FUND=500000000000000000
CALLBACK_FUND=20000000000000000

ORIGIN_ADDR=
REACTIVE_ADDR=
CALLBACK_ADDR=
